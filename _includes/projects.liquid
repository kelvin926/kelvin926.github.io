<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        {% assign project_img_alt = project.img_alt | default: project.title %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt=project_img_alt
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h3 class="card-title project-card-title">{{ project.title }}</h3>
        <p class="card-text">{{ project.description }}</p>
      </div>
    </div>
  </a>
</div>
