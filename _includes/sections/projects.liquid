<div class="projects">
  {% assign selected_projects = site.projects | where: 'group', 'selected' | sort: 'importance' %}
  {% assign other_projects = site.projects | where: 'group', 'other' | sort: 'importance' %}
  {% assign featured_project = selected_projects | where: 'slug', 'romo-s' | first %}

  {% if featured_project %}
    <a class="project-feature" href="{{ featured_project.url | relative_url }}">
      <div class="project-feature-media">
        <img
          src="{{ featured_project.thumb | relative_url }}"
          alt="{{ featured_project.img_alt | escape }}"
          width="1211"
          height="974"
          loading="lazy"
          decoding="async"
        >
      </div>
      <div class="project-feature-copy">
        <h3>{{ featured_project.title }}</h3>
        <p>{{ featured_project.card_description | default: featured_project.description }}</p>
        <span class="project-feature-link">View project <span aria-hidden="true">&rarr;</span></span>
      </div>
    </a>
  {% endif %}

  <h3>Selected Projects</h3>

  <div class="row row-cols-1 row-cols-md-2">
    {% for project in selected_projects %}
      {% unless project.url == featured_project.url %}
        {% include projects.liquid %}
      {% endunless %}
    {% endfor %}
  </div>

  <h3>Other Projects</h3>

  <div class="row row-cols-1 row-cols-md-2">
    {% for project in other_projects %}
      {% include projects.liquid %}
    {% endfor %}
  </div>
</div>
